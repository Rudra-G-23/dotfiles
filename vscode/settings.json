{
    // ==========================================
    // VS CODE DEFAULT SETTINGS (Core & Built-in)
    // ==========================================
    // Files
    "files.eol": "\n",
    "files.autoSave": "afterDelay",
    "files.autoSaveWhenNoErrors": true,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.autoSaveWorkspaceFilesOnly": true,
    "search.exclude": {
        "**/venv": true,
        "**/__pycache__": true,
        "**/.mypy_cache": true,
        "**/.pytest_cache": true,
        "**/.ruff_cache": true,
        "**/node_modules": true
    },
    "explorer.compactFolders": false,
    "explorer.confirmDelete": true,
    "explorer.confirmDragAndDrop": true,
    // Workbench
    "workbench.colorTheme": "Dark Modern",
    "workbench.editor.empty.hint": "hidden",
    "workbench.editor.enablePreview": false,
    "workbench.preferredDarkColorTheme": "Dark Modern",
    "workbench.preferredHighContrastColorTheme": "Dark Modern",
    "workbench.preferredHighContrastLightColorTheme": "Dark Modern",
    "workbench.preferredLightColorTheme": "Dark Modern",
    "workbench.browser.showInTitleBar": true,
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    // Editor
    "editor.wordWrap": "off",
    "editor.cursorBlinking": "expand",
    "editor.suggest.preview": true,
    "editor.formatOnPaste": true,
    "editor.smoothScrolling": true,
    "editor.linkedEditing": true,
    "editor.autoClosingQuotes": "always",
    "editor.autoClosingBrackets": "always",
    "editor.bracketPairColorization.enabled": true,
    "editor.fontFamily": "'JetBrainsMono Nerd Font', Consolas, monospace",
    "editor.fontLigatures": true,
    "editor.fontSize": 15,
    "editor.lineHeight": 24,
    "editor.inlayHints.fontFamily": "'JetBrainsMono Nerd Font'",
    // Terminal
    "terminal.integrated.scrollback": 10000,
    "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font'",
    "terminal.integrated.fontSize": 14,
    // Notebook
    "notebook.lineNumbers": "on",
    "notebook.outline.showCodeCellSymbols": false,
    "notebook.output.textLineLimit": 150,
    "notebook.formatOnSave.enabled": true,
    "notebook.codeActionsOnSave": {
        "notebook.source.fixAll": "explicit",
        "notebook.source.organizeImports": "explicit"
    },
    "notebook.markup.fontFamily": "'JetBrainsMono Nerd Font'",
    // Utils
    "scm.inputFontFamily": "'JetBrainsMono Nerd Font'",
    "window.systemColorTheme": "dark",
    "git.autofetch": true,
    "git.openRepositoryInParentFolders": "never",
    "debug.showVariableTypes": true,
    "interactiveWindow.executeWithShiftEnter": true,
    // ==========================================
    // EXTENSION SETTINGS (Downloaded)
    // ==========================================
    // Tabnine
    "tabnine.experimentalAutoImports": true,
    // Ruff
    "ruff.nativeServer": "auto",
    "[python]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    },
    // Python / Jupyter
    "python.languageServer": "Default",
    "jupyter.interactiveWindow.textEditor.executeSelection": true,
    "jupyter.widgetScriptSources": [
        "jsdelivr.com",
        "unpkg.com"
    ],
    // Data Wrangler
    "dataWrangler.startInEditModeForNotebookEntrypoints": true,
    // Draw.io
    "hediet.vscode-drawio.resizeImages": null,
    // Markdown Preview Enhanced
    "markdown-preview-enhanced.alwaysShowBacklinksInPreview": false,
    "markdown-preview-enhanced.enablePreviewZenMode": false,
    // Material Icon Theme
    "workbench.iconTheme": "material-icon-theme",
    "material-icon-theme.folders.associations": {
        "references": "docs",
        "workflows": "context"
    },
    // Code Spell Checker (cSpell)
    "cSpell.autoFormatConfigFile": false,
    "cSpell.language": "en",
    "cSpell.userWords": [
        "rudra",
        "prasad",
        "bhuyan"
    ],
    "cSpell.dictionaries": [],
    // Live Server (for web app preview)
    "liveServer.settings.donotShowInfoMsg": true,
    // Git Graph
    "git-graph.commitDetailsView.fileView.type": "File List",
}
